# SentinelGrid — Offline-First Emergency Command & Coordination Platform
# Phase 1 Core Operations: 100% Offline-First, Zero Cloud Dependency.
#
# GEMINI_API_KEY: OPTIONAL.
# SentinelGrid Phase 1 DOES NOT require Gemini, cloud databases, or external APIs.
# All core operational triage, incident logging, role-based access control,
# and resource management function completely offline.
# If provided, GEMINI_API_KEY is strictly optional and only evaluated for later-phase AI advisory features.
GEMINI_API_KEY=""

# AUTH_SECRET: OPTIONAL.
# 32-byte secret for HMAC-SHA256 session token signatures.
# If omitted, SentinelGrid automatically generates and persists a cryptographically secure 32-byte secret in data/.auth_secret.
AUTH_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
